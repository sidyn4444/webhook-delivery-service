<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sidyn4444.webhooks</groupId>
        <artifactId>webhook-delivery-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>producer</artifactId>
    <name>producer</name>
    <description>Receives events over HTTP, validates them, and enqueues delivery jobs to Redis</description>

    <dependencies>

        <!--
            WHY: this module creates Event / DeliveryJob objects and writes them
            to Redis — those classes live in common. Without it: won't compile.
            NO <version> — supplied by the root's <dependencyManagement>.
        -->
        <dependency>
            <groupId>io.github.sidyn4444.webhooks</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!--
            WHY: the producer's entire job is RECEIVING HTTP (POST /events).
            Brings Spring MVC (URL -> method), embedded Tomcat (the server),
            and Jackson (JSON <-> Java). Without it: no way to receive an event.
            NO <version> — managed by spring-boot-starter-parent.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            WHY: exposes /actuator/health (proven in 4i). In Week 4 this is the
            target of the K8s liveness + readiness probes. Without it: K8s can't
            tell if the pod is alive or ready -> no self-healing, no chaos demo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            WHY: the producer's second job is putting jobs on the queue. This brings
            Lettuce (the Redis client) plus Spring's RedisTemplate/StringRedisTemplate
            wrapper, and auto-configures a connection from the spring.data.redis.*
            properties. Without it there is nowhere for an accepted event to go.

            It also registers a Redis health indicator into /actuator/health, so the
            endpoint reports DOWN when Redis is unreachable - which is what makes the
            Week 4 readiness probe meaningful (proven in 4i, re-proven in 8a).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            WHY: this is the ENGINE for the constraints declared on Event in common.
            common ships jakarta.validation-api - the annotation definitions only, no
            logic. This starter brings Hibernate Validator, which actually reads them.

            Without it, @Valid on a controller parameter is silently inert: every
            @NotBlank and @Pattern on Event is ignored, malformed input is accepted,
            and nothing anywhere reports that validation never ran.

            The worker deliberately does NOT get this - it processes jobs the producer
            already validated, so it pays nothing for rules it never enforces.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Also inherited from the root: spring-boot-starter-test (all modules) -->

    </dependencies>

    <!-- APP MODULE: repackage into an executable "fat JAR" (what Week 4's Dockerfile copies in) -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
