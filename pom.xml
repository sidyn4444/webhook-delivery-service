<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         INHERITANCE: we inherit from Spring Boot's parent POM.
         It supplies tested-together versions for every Spring library
         plus sane plugin defaults, so we never pick versions by hand.
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- empty = look in the Maven repo, not a local folder -->
    </parent>

    <!-- ============================================================
         IDENTITY — the 3 "GAV coordinates" that uniquely name this
         project, the same way you'd name any library you depend on.
           groupId    = who made it   (reverse domain, globally unique)
           artifactId = what it is
           version    = which build   (SNAPSHOT = draft, changes often)
         Together they become the folder path in ~/.m2/repository/.
         ============================================================ -->
    <groupId>io.github.sidyn4444.webhooks</groupId>
    <artifactId>webhook-delivery-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!-- SEPARATE from identity: what does building this produce?
         jar = a JAR file (the default, used by our 3 modules)
         pom = nothing. This project only coordinates other projects. -->
    <packaging>pom</packaging>

    <name>webhook-delivery-service</name>
    <description>Distributed webhook delivery service — Spring Boot producer/worker on Redis, deployed to AWS EKS</description>

    <!-- ============================================================
         AGGREGATION: the modules this root builds, in dependency
         order. Maven works out the order itself — 'common' first,
         because the other two depend on it.
         ============================================================ -->
    <modules>
        <module>common</module>
        <module>producer</module>
        <module>worker</module>
    </modules>

    <!-- ============================================================
         PROPERTIES: named values reused below and inherited by every
         module. One place to change a version.
         ============================================================ -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned by hand ON PURPOSE. Spring Boot's parent manages versions for
             every plugin it knows about (surefire, compiler, the boot plugin) —
             confirmed by grepping the effective POM, where "jacoco" appears 0 times.
             JaCoCo is not one of them, so leaving the version off would resolve
             to whatever Maven felt like that day and could change between machines. -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- ============================================================
         DEPENDENCY MANAGEMENT: declares the VERSION of our own
         'common' module so the child poms can depend on it without
         repeating a version. This section grants nothing on its own —
         it only says "if you ask for this, here's which version."
         ============================================================ -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.sidyn4444.webhooks</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================
         DEPENDENCIES: given to EVERY module, no asking. Kept
         deliberately tiny — only what all three genuinely need.
         ============================================================ -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope> <!-- test scope = compiled for tests, never shipped in the JAR -->
        </dependency>
    </dependencies>

    <!-- ============================================================
         BUILD: plugins are NOT dependencies. A dependency is code our
         program uses at runtime; a plugin is code MAVEN runs while
         building. Declared here in the root, every module inherits it,
         so coverage is measured project-wide from one place.
         ============================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>

                    <!-- 1. Attach the recorder BEFORE the tests run.
                         This does not run tests. It builds a -javaagent:... flag
                         and writes it into the 'argLine' property, which Surefire
                         then passes to the test JVM. The agent rewrites each class
                         as it loads so every line reports whether it executed.
                         ⚠️ If anything ever hard-codes <argLine> in Surefire config,
                         it overwrites this and every report silently reads 0%. -->
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- 2. Turn the raw recording (target/jacoco.exec) into readable
                         reports: HTML to browse, CSV/XML to measure from a script.
                         Bound to 'test' rather than its default 'verify' so that a
                         plain `mvn test` produces a report too — otherwise the report
                         only appears on `mvn verify`/`install`, which looks exactly
                         like the plugin not working. -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!-- 3. NOT PRESENT, DELIBERATELY: the 'check' goal.
                         'check' fails the build when coverage drops below a
                         threshold. Report-only was the decision (SESSION_CHECKLIST,
                         design decision #4) — enforcing costs a red build on every
                         regression. The price of not having it: a later coverage
                         drop goes unannounced. -->

                </executions>
            </plugin>
        </plugins>
    </build>

</project>
