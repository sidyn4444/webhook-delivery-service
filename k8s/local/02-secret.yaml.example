# =============================================================================
#  webhook-secrets — TEMPLATE ONLY. DUMMY VALUES. SAFE TO COMMIT.
#
#  🔴 NOTE THE FILENAME: `02-secret.yaml.example`, not `02-secret.example.yaml`.
#     `kubectl apply -f <directory>` reads only files ending .yaml / .yml / .json,
#     so this ordering makes the template INVISIBLE to a directory apply.
#     That is not cosmetic. This file carries `metadata.name: webhook-secrets`,
#     so with a .yaml extension `kubectl apply -f k8s/local/` silently OVERWRITES
#     the real Secret with the dummy values below -- and the symptom is every
#     service failing to authenticate against Redis and Postgres at once, with a
#     manifest directory that looks completely correct.
#     Caught by `kubectl apply --dry-run=server` at 21c, before it ever ran.
#
#  🔴 THE REAL SECRET IS NEVER WRITTEN TO DISK AND NEVER COMMITTED.
#     It is created imperatively from .env (command at the bottom of this file),
#     so no file containing real credentials ever exists in this repo.
#     .gitignore additionally blocks k8s/**/*secret*.yaml, because git history is
#     append-only: one `git add -f` and an HMAC key is public forever.
#
#  WHAT A KUBERNETES SECRET ACTUALLY BUYS YOU — say this accurately:
#    ✅ the value is not in the git repo   (this one goes PUBLIC in Week 6)
#    ✅ the value is not in the image      (an image is a file that gets copied
#                                          around; 19a found a readable .env
#                                          baked into a test image)
#    ✅ read access is separately grantable via RBAC, per namespace
#    ❌ NOT encryption. The `data:` field is base64 -- a reversible text
#       encoding. Anyone who can read the object decodes it in one command:
#           kubectl get secret webhook-secrets -n webhooks \
#             -o jsonpath='{.data.REDIS_PASSWORD}' | base64 -d
#    ❌ NOT encrypted at rest by default either. Secrets sit in etcd in the
#       clear unless the cluster enables encryption-at-rest (on EKS, a KMS key).
#
#  WHY PRODUCTION USES AWS SECRETS MANAGER INSTEAD (decided chat 4):
#    the secret is not in the cluster AT ALL, so compromising the cluster does
#    not reach it. Plus rotation and an audit trail, neither of which a K8s
#    Secret has. It is also the only AWS API call in this system, which is what
#    gives IRSA a real job in Session 5. This Secret stays as the fallback.
#
#  WHY THESE FOUR KEYS AND NOT SIX:
#    .env holds six variables. POSTGRES_URL and POSTGRES_DB are NOT secrets --
#    they are hostnames and a database name, and they live in
#    01-configmap.yaml. Creating this with `--from-env-file=.env` would sweep
#    them in (measured: 6 keys, not 4), leaving the SAME value stored in two
#    objects that are then free to drift apart.
#
#  ⚠️ POSTGRES_USER is here even though a username is not really secret. It is
#     half of a credential, and splitting a credential across two objects buys
#     nothing while making it easy to rotate one half. Different rule from
#     "hide secrets": keep a credential in one place.
#
#  ⚠️ These arrive in the pod as ENVIRONMENT VARIABLES, because that is what the
#     apps read. Stated trade: env vars are visible to anything that can read
#     the process environment, and they leak into crash dumps and child
#     processes. Mounting as files is marginally safer.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: webhook-secrets
  namespace: webhooks
  labels:
    app.kubernetes.io/part-of: webhook-delivery-service
type: Opaque
# stringData takes PLAIN TEXT and lets Kubernetes do the base64 itself.
# Prefer it over `data:` when writing a manifest by hand.
#
# ⚠️ THE TRAP IN HAND-ROLLING `data:` -- measured, not theoretical:
#      echo "$PW"        | base64   -> decodes to 24 bytes
#      printf '%s' "$PW" | base64   -> decodes to 23 bytes   <- correct
#    `echo` appends a newline (0x0a). The password is then silently wrong by one
#    byte, Redis rejects it, and nothing about the manifest looks wrong.
#    Use `printf '%s'`, or use stringData and avoid the question entirely.
stringData:
  # Redis AUTH password. Read by BOTH services (spring.data.redis.password).
  REDIS_PASSWORD: "replace-me-redis-password"

  # Postgres credentials. Read by the WORKER only.
  POSTGRES_USER: "replace-me-db-user"
  POSTGRES_PASSWORD: "replace-me-db-password"

  # HMAC-SHA256 signing key for outbound webhooks (webhook.hmac.secret).
  # Read by the WORKER only. The subscriber holds the same value -- rotating it
  # is a two-sided change, which is why real systems support two live keys.
  HMAC_SECRET: "replace-me-64-hex-chars"

# -----------------------------------------------------------------------------
#  HOW TO CREATE THE REAL ONE (nothing lands on disk):
#
#    set -a && . ./.env && set +a
#    umask 077
#    TRIM=$(mktemp)
#    for k in REDIS_PASSWORD POSTGRES_USER POSTGRES_PASSWORD HMAC_SECRET; do
#      eval "printf '%s=%s\n' \"$k\" \"\$$k\"" >> "$TRIM"
#    done
#    kubectl create secret generic webhook-secrets -n webhooks --from-env-file="$TRIM"
#    rm -f "$TRIM"
#
#  A trimmed file rather than --from-literal on purpose: a value passed on the
#  command line is visible in the process table and lands in shell history.
#
#  TO VERIFY (fingerprints only, never print the value):
#    kubectl get secret webhook-secrets -n webhooks \
#      -o jsonpath='{.data.REDIS_PASSWORD}' | base64 -d | shasum -a 256
#
#  TO ROTATE: recreate it, then restart the pods --
#    kubectl delete secret webhook-secrets -n webhooks
#    ...create again...
#    kubectl rollout restart deployment -n webhooks
#  Env vars are handed to a process ONCE, at startup. Changing the Secret does
#  nothing to a running pod.
# -----------------------------------------------------------------------------
