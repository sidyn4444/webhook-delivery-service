<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sidyn4444.webhooks</groupId>
        <artifactId>webhook-delivery-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>worker</artifactId>
    <name>worker</name>
    <description>Pulls delivery jobs from Redis and POSTs HMAC-signed webhooks to subscriber URLs</description>

    <dependencies>

        <!--
            WHY: this module reads DeliveryJob objects OUT of Redis — the same
            classes the producer wrote IN. This is the shared contract in action:
            one definition, so the two sides cannot drift apart.
            NO <version> — supplied by the root's <dependencyManagement>.
        -->
        <dependency>
            <groupId>io.github.sidyn4444.webhooks</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!--
            WHY: plain spring-boot-starter, NOT -starter-web (deliberate).
            Gives the machinery to BE a Spring app — dependency injection,
            config loading, logging — with no web server.
            The worker is a DAEMON: it pulls from a queue, nobody calls it.
            Shipping -web would mean a bigger image, a wider attack surface,
            an open port nobody should reach, and slower startup — for a door
            nobody knocks on.
            (5f sets spring.main.web-application-type=none to make it explicit.)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            WHY: the worker's whole existence is reading jobs OFF the queue the
            producer fills. This brings Lettuce (the Redis client) plus Spring's
            StringRedisTemplate, and auto-configures the connection from the
            spring.data.redis.* properties. Without it the worker has no way to
            reach the queue at all.

            Same starter the producer uses (8a) — deliberately. The two services
            talk to the same Redis with the same client, so a behaviour that works
            on one side is not a surprise on the other.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            WHY: WebClient — the HTTP client the worker uses to POST webhooks to
            subscriber URLs (9c). It ships inside the WebFlux starter; there is no
            smaller artifact that provides it.

            ⚠️ THE TRAP: this starter also contains a reactive Netty web SERVER.
            Spring Boot picks its application type from the classpath, and webflux
            present + spring-webmvc absent normally means "start a reactive server
            on a port". That is the opposite of what a daemon wants.

            spring.main.web-application-type=none (already set in
            application.properties since 5f) overrides that inference and keeps the
            worker serverless. That property was documentation before this line
            existed; adding webflux is what makes it load-bearing.

            The alternative — Java's built-in java.net.http.HttpClient, no
            dependency at all — is rejected because WebClient gives a per-request
            timeout, connection pooling, and a filter chain for the HMAC signing
            header in Session 3, all of which we would otherwise hand-roll.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Also inherited from the root: spring-boot-starter-test (all modules) -->

        <!--
            Task 10 adds:
              spring-boot-starter-data-jpa
              postgresql                     -> the delivery log (2b) — worker only,
                                                the producer never touches Postgres
        -->

    </dependencies>

    <!-- APP MODULE: repackage into an executable "fat JAR" -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
