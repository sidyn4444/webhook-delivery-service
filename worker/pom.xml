<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sidyn4444.webhooks</groupId>
        <artifactId>webhook-delivery-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>worker</artifactId>
    <name>worker</name>
    <description>Pulls delivery jobs from Redis and POSTs HMAC-signed webhooks to subscriber URLs</description>

    <dependencies>

        <!--
            WHY: this module reads DeliveryJob objects OUT of Redis — the same
            classes the producer wrote IN. This is the shared contract in action:
            one definition, so the two sides cannot drift apart.
            NO <version> — supplied by the root's <dependencyManagement>.
        -->
        <dependency>
            <groupId>io.github.sidyn4444.webhooks</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!--
            WHY: plain spring-boot-starter, NOT -starter-web (deliberate).
            Gives the machinery to BE a Spring app — dependency injection,
            config loading, logging — with no web server.
            The worker is a DAEMON: it pulls from a queue, nobody calls it.
            Shipping -web would mean a bigger image, a wider attack surface,
            an open port nobody should reach, and slower startup — for a door
            nobody knocks on.
            (5f sets spring.main.web-application-type=none to make it explicit.)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            WHY: the worker's whole existence is reading jobs OFF the queue the
            producer fills. This brings Lettuce (the Redis client) plus Spring's
            StringRedisTemplate, and auto-configures the connection from the
            spring.data.redis.* properties. Without it the worker has no way to
            reach the queue at all.

            Same starter the producer uses (8a) — deliberately. The two services
            talk to the same Redis with the same client, so a behaviour that works
            on one side is not a surprise on the other.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            WHY: WebClient — the HTTP client the worker uses to POST webhooks to
            subscriber URLs (9c). It ships inside the WebFlux starter; there is no
            smaller artifact that provides it.

            ⚠️ THE TRAP: this starter also contains a reactive Netty web SERVER.
            Spring Boot picks its application type from the classpath, and webflux
            present + spring-webmvc absent normally means "start a reactive server
            on a port". That is the opposite of what a daemon wants.

            spring.main.web-application-type=none (already set in
            application.properties since 5f) overrides that inference and keeps the
            worker serverless. That property was documentation before this line
            existed; adding webflux is what makes it load-bearing.

            The alternative — Java's built-in java.net.http.HttpClient, no
            dependency at all — is rejected because WebClient gives a per-request
            timeout, connection pooling, and a filter chain for the HMAC signing
            header in Session 3, all of which we would otherwise hand-roll.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
            WHY: the delivery log (2b). Every attempt — success or failure — becomes a
            durable row in Postgres, because a log line answers "what is happening now"
            and nothing answers "what happened to event X last Tuesday" once the log
            has rotated away.

            WORKER ONLY. The producer never touches Postgres: it accepts an event and
            queues it, and it has no outcome to record. Adding this dependency there
            would give it a database connection it has no use for — more startup time,
            more attack surface, and a service that fails to start when a database it
            never queries is down.

            WHAT THIS STARTER ACTUALLY BRINGS: Spring Data JPA (the repository layer),
            Hibernate (the JPA implementation that turns annotated objects into SQL),
            and HikariCP (the connection pool). Note that Hibernate is NOT part of
            Spring — it is a separate library that Spring Boot bundles as its default
            choice. Our code depends on the jakarta.persistence annotations, not on
            Hibernate classes, which is what would make swapping it a pom change rather
            than a rewrite.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            WHY: JPA is useless on its own. Java ships JDBC as an INTERFACE — a set of
            method names with no working code behind them — because it cannot know which
            database you chose. This jar is the implementation for Postgres: the classes
            that actually open a socket to 5432 and encode Postgres's wire protocol.
            Without it, startup fails with "Cannot load driver class: org.postgresql.Driver".

            <scope>runtime</scope> IS THE INTERESTING PART. Runtime scope means the jar is
            present when the application RUNS but absent when it COMPILES. Nothing in this
            codebase names a Postgres class — Hibernate only ever calls the generic
            java.sql interfaces — so compiling against it would buy nothing and cost
            something real: it would make `import org.postgresql.*` possible, and the first
            person who reaches for a vendor-specific type quietly welds the application to
            one database. The scope makes that a compile error instead of a code review.

            NO <version>: supplied by spring-boot-starter-parent, which pins a driver
            version tested against this Spring Boot release.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Also inherited from the root: spring-boot-starter-test (all modules) -->

        <!--
            Task 10c adds:
              flyway-core                    -> versioned schema migrations, so the table
              flyway-database-postgresql        is created by a reviewed script rather than
                                                by Hibernate guessing from the entity
        -->

    </dependencies>

    <!-- APP MODULE: repackage into an executable "fat JAR" -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
