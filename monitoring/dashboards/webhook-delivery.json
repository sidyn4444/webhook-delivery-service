    {
      "id": 9,
      "type": "stat",
      "title": "Container restarts",
      "description": "Total container restarts in the webhooks namespace.\n\nShould be 0 in steady state. A rising count with healthy delivery throughput is the signature of a probe budget that is too tight rather than an application fault -- exactly the defect recorded at 24a, where a cold start exceeded the worker's 150s startup budget and the killed container's log contained no error at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"webhooks\"})",
