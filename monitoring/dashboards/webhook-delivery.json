    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retries \u2014 the level and the tally",
      "description": "Both series are needed and each is blind to what the other sees.\n\n'waiting on backoff' is a GAUGE: how many are scheduled right now. 'scheduled/sec' is a COUNTER read through rate(): how fast we are deciding to retry.\n\nA retry set that is empty right now and one that has never been used read IDENTICALLY on the gauge, and are opposite situations. Measured on this cluster: depth 3 while the counter stood at 11 -- a panel built on the gauge alone would have shown a flat zero through eleven retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(webhook_retry_depth)",
          "legendFormat": "waiting on backoff",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(webhook_retries_scheduled_total[5m]))",
          "legendFormat": "scheduled/sec",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
