    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue backlog (the saturation test)",
      "description": "Jobs waiting to be picked up.\n\nTHE PANEL THAT DECIDES WHETHER A THROUGHPUT NUMBER IS HONEST. A system accepting 500 events/sec while delivering 200/sec looks perfectly healthy from the producer's side, because POST /events returns 202 either way -- it accepted the event and promised nothing about when.\n\nSustained throughput is the rate at which THIS LINE STAYS FLAT. A rising line means the reported delivery rate is a measurement of the load generator, not of the system.\n\nmax() NOT sum(): see the DLQ panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(webhook_queue_depth)",
          "legendFormat": "queued",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(webhook_processing_depth)",
          "legendFormat": "in flight",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
