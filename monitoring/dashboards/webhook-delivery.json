    {
      "id": 10,
      "type": "stat",
      "title": "Ingest p95 (producer)",
      "description": "How long POST /events takes to validate, run the SSRF check, enqueue and return 202.\n\nNOT delivery latency -- a different question, and conflating the two makes a load test unreadable. This one answers 'is the front door still fast while the queue is backing up?', which is what separates a producer problem from a worker problem under load.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/events\"}[5m])) by (le))",
          "legendFormat": "ingest p95",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
