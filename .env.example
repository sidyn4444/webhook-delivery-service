# =============================================================
#  .env.example — TEMPLATE of every environment variable this project needs.
#
#  Copy to `.env` and fill in real values:   cp .env.example .env
#  `.env` is gitignored (5g). THIS file is committed.
#  Dummy values only — never put a real secret in .env.example.
#
#  Why this file exists: the real `.env` can never be committed, but anyone
#  cloning the repo still has to know WHICH variables exist. This is the
#  blank form; `.env` is the filled-in copy that stays on your machine.
#
#  How the values actually reach the code (notes 3d):
#     .env  ->  docker-compose / your shell reads it  ->  environment variables
#           ->  ${PLACEHOLDER} in application.properties resolves against them
#  Spring does NOT read .env itself.
# =============================================================


# --- Redis: the job queue ------------------------------------
#  Local: the docker-compose container.  AWS (Wk5): ElastiCache.
#  Host and port have defaults in application.properties, so they're only
#  needed when pointing somewhere other than localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
#  No default in application.properties, deliberately: a missing password
#  must crash the app at startup rather than silently connect to an
#  unauthenticated Redis. (Notes 4h — Redis shipped open by default for
#  years and it remains one of the most-exploited misconfigurations online.)
REDIS_PASSWORD=changeme-redis-local


# --- Postgres: the delivery attempt log ----------------------
#  Local: the docker-compose container.  AWS (Wk5): RDS.
#  Consumed by the WORKER only — the producer never touches Postgres.
POSTGRES_USER=webhook
POSTGRES_PASSWORD=changeme-postgres-local
POSTGRES_DB=webhookdb
POSTGRES_URL=jdbc:postgresql://localhost:5432/webhookdb


# --- Application secrets -------------------------------------
#  Shared secret used to HMAC-SHA256 sign every outbound webhook, so a
#  subscriber can verify the request genuinely came from us and wasn't
#  tampered with in transit (notes 3a). Needed from Week 3.
#  Generate a real one with:   openssl rand -hex 32
HMAC_SECRET=changeme-generate-with-openssl-rand-hex-32


# --- Spring profile ------------------------------------------
#  Leave unset for the default profile. Set to `local` to also load
#  application-local.properties (gitignored) for developer conveniences
#  such as DEBUG logging and SQL echo.
# SPRING_PROFILES_ACTIVE=local


# =============================================================
#  NOT in this file, on purpose:
#
#  Production values. In AWS these come from Secrets Manager, fetched by
#  the pods via IRSA — no long-lived credentials on disk anywhere
#  (notes 3c, 3d). This file only ever describes LOCAL development.
# =============================================================
